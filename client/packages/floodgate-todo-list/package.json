{
	"name": "@tylerbu/floodgate-todo-list",
	"version": "0.0.1",
	"private": true,
	"description": "Collaborative todo-list example using Floodgate (Routerlicious) client and Fluid Framework SharedTree",
	"bugs": "https://github.com/tylerbutler/levee/issues",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/tylerbutler/levee.git",
		"directory": "client/packages/floodgate-todo-list"
	},
	"license": "MIT",
	"author": "Tyler Butler <tyler@tylerbutler.com>",
	"type": "module",
	"main": "./src/index.ts",
	"exports": {
		".": "./src/index.ts",
		"./sandbag": "./src/sandbag.ts"
	},
	"scripts": {
		"build:compile": "tsc --project ./tsconfig.json",
		"build:vite": "vite build",
		"check:format": "biome format .",
		"clean": "rimraf esm dist _temp *.tsbuildinfo",
		"dev": "vite",
		"format": "biome check . --linter-enabled=false --write",
		"lint": "biome lint .",
		"lint:fix": "biome lint . --write",
		"preview": "vite preview",
		"test:vitest": "vitest run test/unit",
		"test:vitest:integration": "FLOODGATE_INTEGRATION=1 vitest run test/integration"
	},
	"dependencies": {
		"@fluidframework/merge-tree": "<2.100.0",
		"@fluidframework/react": "<2.100.0",
		"@fluidframework/sequence": "<2.100.0",
		"@fluidframework/shared-object-base": "<2.100.0",
		"@tylerbu/floodgate-client": "workspace:^",
		"fluid-framework": "<2.100.0",
		"react": "^18.3.1",
		"react-dom": "^18.3.1"
	},
	"devDependencies": {
		"@biomejs/biome": "2.3.8",
		"@types/node": "^20.19.25",
		"@types/react": "^18.3.12",
		"@types/react-dom": "^18.3.1",
		"@vitejs/plugin-react": "^4.3.4",
		"rimraf": "^6.1.2",
		"typescript": "~5.9.3",
		"vite": "^7.3.2",
		"vitest": "^4.1.0"
	},
	"engines": {
		"node": ">=18.0.0"
	}
}
