{
	"name": "@tylerbu/floodgate-workspace",
	"version": "0.0.0",
	"private": true,
	"description": "TypeScript client and examples for Floodgate",
	"license": "MIT",
	"author": "Tyler Butler <tyler@tylerbutler.com>",
	"type": "module",
	"scripts": {
		"build": "workspaces-to-typescript-project-references && tsc --build",
		"check": "biome check .",
		"check:format": "biome format .",
		"check:references": "workspaces-to-typescript-project-references --check",
		"fix:references": "workspaces-to-typescript-project-references",
		"clean": "rimraf --glob \"packages/*/esm\" \"packages/*/dist\" \"packages/*/*.tsbuildinfo\"",
		"format": "biome check . --linter-enabled=false --write",
		"lint": "biome lint .",
		"lint:fix": "biome lint . --write",
		"test": "vitest run",
		"test:routerlicious": "FLOODGATE_ROUTERLICIOUS_COMPAT=1 vitest run test/conformance/floodgate-routerlicious.test.ts",
		"test:phoenix": "FLOODGATE_PHOENIX_COMPAT=1 FLOODGATE_ROUTERLICIOUS_COMPAT=1 vitest run test/conformance/floodgate-phoenix.test.ts",
		"test:conformance": "pnpm test:routerlicious",
		"check:floodgate-readiness-manifest": "vitest run test/conformance/floodgate-readiness.test.ts",
		"check:floodgate-readiness": "node scripts/check-floodgate-release.mjs",
		"ci:publish": "pnpm publish -r --access public --provenance --report-summary --no-git-checks"
	},
	"devDependencies": {
		"@biomejs/biome": "2.3.8",
		"@fluidframework/driver-definitions": "^2.81.1",
		"@fluidframework/map": "^2.81.1",
		"@fluidframework/protocol-definitions": "^2.1.0",
		"@fluidframework/routerlicious-driver": "^2.81.1",
		"@monorepo-utils/workspaces-to-typescript-project-references": "^2.11.0",
		"@tsconfig/node18": "^18.2.6",
		"@tylerbu/levee-driver": "^0.1.2",
		"jose": "^6.1.3",
		"rimraf": "^6.1.2",
		"typescript": "~5.9.3",
		"uuid": "^13.0.0",
		"vitest": "^4.1.0"
	},
	"packageManager": "pnpm@10.24.0"
}
