---
interface Props {
	direction: "left" | "right";
}

const { direction } = Astro.props;
---

<svg
	class="icon-arrow"
	viewBox="0 0 20 20"
	aria-hidden="true"
	focusable="false"
>
	{direction === "left" ? (
		<path d="M17 10H5m4-5-5 5 5 5" />
	) : (
		<path d="M3 10h12m-4-5 5 5-5 5" />
	)}
</svg>
