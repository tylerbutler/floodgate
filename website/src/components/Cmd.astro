---
interface Props {
	command: string;
	/** Marks the command destructive and states what it destroys. */
	warn?: string;
}

const { command, warn } = Astro.props;

// Tie the copy button to its warning so a screen reader hears the consequence
// before the action, not three rows later.
const warnId = warn
	? `warn-${command.replace(/[^a-z0-9]+/gi, "-").replace(/^-|-$/g, "").toLowerCase().slice(0, 40)}`
	: undefined;
---

<pre class="cmd"><code>{command}</code><button
		class="cmd__copy"
		type="button"
		data-copy={command}
		aria-label={`Copy command: ${command}`}
		aria-describedby={warnId}
		aria-live="polite"
		hidden
	>Copy</button></pre>
{warn && (
	<p class="cmd-warn" id={warnId}>
		<span class="cmd-warn__tag">[destructive]</span> {warn}
	</p>
)}

<script>
	// Buttons ship hidden so a no-JS page never shows a control that can't work.
	for (const btn of document.querySelectorAll<HTMLButtonElement>("[data-copy]")) {
		btn.hidden = false;
		btn.addEventListener("click", async () => {
			try {
				await navigator.clipboard.writeText(btn.dataset.copy ?? "");
				btn.textContent = "Copied";
			} catch {
				const code = btn.closest(".cmd")?.querySelector("code");
				if (code) {
					const selection = window.getSelection();
					const range = document.createRange();
					range.selectNodeContents(code);
					selection?.removeAllRanges();
					selection?.addRange(range);
					btn.textContent = "Selected — copy manually";
				} else {
					btn.textContent = "Copy unavailable";
				}
			}
			setTimeout(() => {
				btn.textContent = "Copy";
			}, 3000);
		});
	}
</script>
