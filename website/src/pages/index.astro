---
import Cmd from "../components/Cmd.astro";
import Terminal from "../layouts/Terminal.astro";

const bootLines = [
	{ text: "loading spillway protocol engine…", tag: "boot" },
	{ text: "loading beryl coordinator…", tag: "boot" },
	{ text: "binding localhost:3000", tag: "net" },
	{ text: "listening — official Fluid/Routerlicious drivers", tag: "socket.io", ok: true },
	{ text: "listening — Phoenix Channels (levee-driver, levee-client)", tag: "phx", ok: true },
	{ text: "floodgate is up. two protocols, one process.", tag: "ready", ok: true },
];

const whyBeam = [
	{ text: "restart_strategy: one_for_one", tag: "sup" },
	{ text: "each document session is its own isolated process", tag: "sup" },
	{ text: "a crashed session does not take the node down", tag: "sup" },
	{ text: "protocol logic is compiled and type-checked before it ever runs", tag: "gleam" },
];

const capabilities = [
	{ label: "dual-mode wire protocols", detail: "Socket.IO + Phoenix Channels, from one process" },
	{ label: "presence_v1", detail: "server-backed roster, both endpoints, no client heartbeat needed" },
	{ label: "git-like storage", detail: "blobs, trees, commits, refs — per tenant" },
	{ label: "multi-tenancy", detail: "dynamic tenants, two rotating JWT secret slots each" },
	{ label: "self-hosted", detail: "single binary or `docker compose up`" },
];
---

<Terminal
	title="Floodgate — a Fluid Framework server on the BEAM"
	description="Floodgate is a Fluid Framework server written in Gleam, running on the BEAM. Dual-mode wire protocols, one process, fault-tolerant by construction."
	path="/"
>
	<p class="prompt">FLOODGATE_JWT_SECRET=dev-secret gleam run</p>
	<ul class="log" aria-label="Startup log">
		{bootLines.map((line, i) => (
			<li style={`--i:${i}`}>
				<span class="log__tag">[{line.tag}]</span>{" "}
				<span class={line.ok ? "log__ok" : undefined}>{line.text}</span>
			</li>
		))}
	</ul>
	<p>
		<span aria-hidden="true">_</span><span class="cursor" aria-hidden="true"></span>
	</p>

	<h1 class="page-title">floodgate</h1>
	<p class="lede">
		A <a href="https://fluidframework.com"><strong>Fluid Framework</strong></a>{" "}
		server written in Gleam, running on the BEAM. One process speaks the
		official Fluid wire protocol and Phoenix Channels at once, so it's also a
		drop-in replacement for <a href="/docs/development">Levee</a>, the sibling
		Elixir server it's conformance-tested against.
	</p>

	<h2 class="rule-label">why the BEAM</h2>
	<ul class="log log--static" aria-label="Runtime properties">
		{whyBeam.map((line) => (
			<li>
				<span class="log__tag">[{line.tag}]</span> {line.text}
			</li>
		))}
	</ul>
	<p>
		Gleam compiles to the same virtual machine that has run telecom switches
		for decades. Every document gets its own supervised process: one
		session crashing and restarting is normal operation, not an incident,
		and the sequencing logic that decides what happened next is checked by
		the compiler before it ships.
	</p>

	<h2 class="rule-label">capabilities</h2>
	<ul class="log log--static" aria-label="Capabilities">
		{capabilities.map((cap) => (
			<li>
				<span class="log__tag">[cap]</span> <strong>{cap.label}</strong>
				<span class="note"> — {cap.detail}</span>
			</li>
		))}
	</ul>

	<hr />

	<h2 class="rule-label">try it</h2>
	<Cmd command="docker compose up -d --wait" />
	<p class="note">
		starts on http://localhost:3000 — full steps in{" "}
		<a href="/docs/getting-started">getting started</a>.
	</p>
	<p>
		No benchmarks to show yet — instead, Levee's <strong>unmodified</strong>{" "}
		integration suites (<code>levee-driver</code>, <code>levee-client</code>,{" "}
		<code>levee-example</code>) run against a containerised Floodgate,
		repointed only by environment variable. Nothing in those suites is
		Floodgate-aware, so any failure is a real behavioral difference between
		the servers. <a href="/docs/development">How the conformance suites work.</a>
	</p>
	<a class="cta" href="/docs/getting-started">read the docs</a>
	<p class="note">
		<a href="https://github.com/tylerbutler/floodgate">view source at tylerbutler/floodgate</a>
	</p>
</Terminal>
