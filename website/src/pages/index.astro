---
import Cmd from "../components/Cmd.astro";
import SupervisorLog from "../components/SupervisorLog.astro";
import Terminal from "../layouts/Terminal.astro";

const bootLines = [
	{ text: "loading spillway protocol engine…", tag: "boot" },
	{ text: "loading beryl coordinator…", tag: "boot" },
	{ text: "binding localhost:3000", tag: "net" },
	{ text: "listening — official Fluid/Routerlicious drivers", tag: "socket.io", ok: true },
	{ text: "listening — Phoenix Channels (levee-driver, levee-client)", tag: "phx", ok: true },
	{ text: "floodgate is up. two protocols, one process.", tag: "ready", ok: true },
];

const whyBeam = [
	{ text: "restart_strategy: one_for_one", tag: "sup" },
	{ text: "each document session is its own isolated process", tag: "sup" },
	{ text: "a crashed session does not take the node down", tag: "sup" },
	{ text: "protocol logic is compiled and type-checked before it ever runs", tag: "gleam" },
];

const capabilities = [
	{ tag: "proto", label: "dual-mode wire protocols", detail: "Socket.IO + Phoenix Channels, from one process" },
	{ tag: "presence", label: "presence_v1", detail: "server-backed roster, both endpoints, no client heartbeat needed" },
	{ tag: "storage", label: "git-like storage", detail: "blobs, trees, commits, refs — per tenant" },
	{ tag: "tenancy", label: "multi-tenancy", detail: "dynamic tenants, two rotating JWT secret slots each" },
	{ tag: "deploy", label: "self-hosted", detail: "single binary or `docker compose up`" },
];
---

<Terminal
	title="Floodgate — a Fluid Framework server on the BEAM"
	description="Floodgate is a Fluid Framework server written in Gleam, running on the BEAM. Dual-mode wire protocols, one process, fault-tolerant by construction."
	path="/"
>
	<header class="hero">
		<div class="hero__pitch">
			<h1 class="page-title">
				<span class="page-title__product">floodgate</span>
				<span class="page-title__promise">A fault-isolated Fluid server on the BEAM.</span>
			</h1>
			<p class="lede">
				Use Floodgate as the self-hosted collaboration backend for a{" "}
				<a href="https://fluidframework.com" rel="noopener external">Fluid Framework</a> app. Each
				document runs in its own supervised BEAM process, while one server
				speaks the official Fluid protocol and Phoenix Channels.
			</p>
			<div class="hero__actions">
				<a class="cta" href="/docs/getting-started">get Floodgate running</a>
				<a class="text-action" href="/architecture">see how isolation works</a>
			</div>
		</div>

		<div class="hero__proof">
			<SupervisorLog label="what a crash looks like" />
		</div>
	</header>

	<section class="boot-proof" aria-labelledby="boot-proof-title">
		<h2 class="rule-label" id="boot-proof-title">one server, two protocols</h2>
		<ul class="log" data-reveal aria-label="Floodgate startup log">
			{bootLines.map((line, i) => (
				<li style={`--i:${i}`}>
					<span class="log__tag">[{line.tag}]</span>{" "}
					<span class={line.ok ? "log__ok" : undefined}>{line.text}</span>
				</li>
			))}
		</ul>
	</section>

	<h2 class="rule-label">why the BEAM</h2>
	<ul class="log log--static" aria-label="Runtime properties">
		{whyBeam.map((line) => (
			<li>
				<span class="log__tag">[{line.tag}]</span> {line.text}
			</li>
		))}
	</ul>
	<p>
		Gleam compiles to the same virtual machine that has run telecom switches
		for decades. Every document gets its own supervised process: one
		session crashing and restarting is normal operation, not an incident,
		and the sequencing logic that decides what happened next is checked by
		the compiler before it ships.
	</p>

	<h2 class="rule-label">capabilities</h2>
	<ul class="log log--static" aria-label="Capabilities">
		{capabilities.map((cap) => (
			<li>
				<span class="log__tag">[{cap.tag}]</span> <strong>{cap.label}</strong>
				<span class="note">: {cap.detail}</span>
			</li>
		))}
	</ul>

	<hr />

	<h2 class="rule-label">try it</h2>
	<p>From the Floodgate repository root, with Docker Compose installed:</p>
	<Cmd command="docker compose up -d --wait" />
	<p class="note">
		starts on http://localhost:3000. The included Compose file uses known
		development credentials and permissive browser origins; replace both
		before deploying. Full steps in{" "}
		<a href="/docs/getting-started">getting started</a>.
	</p>
	<p>
		Floodgate is checked against Levee's <strong>unmodified</strong>{" "}
		integration suites for <code>levee-driver</code>, <code>levee-client</code>,
		and <code>levee-example</code>. The suites are repointed only by
		environment variable, so a failure reveals a real behavioral difference
		between the servers.{" "}
		<a href="/docs/development">Review the conformance test setup.</a>
	</p>
	<p class="note">Performance benchmarks are not published yet.</p>
	<a class="cta" href="/docs/getting-started">get Floodgate running</a>
</Terminal>
