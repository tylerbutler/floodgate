---
import GrepFilter from "../../components/GrepFilter.astro";
import DocsNode from "../../layouts/DocsNode.astro";
import { routeGroups as groups, routeId } from "../../data/routes";
---

<DocsNode
	slug="http-surface"
	description="The full Floodgate HTTP endpoint reference — health, admin, auth, tenants, documents, and git-like storage."
>
	<p>
		Every route below is served by the same process as the WebSocket
		endpoints — see <a href="/architecture">architecture</a> for how the
		transports and this HTTP surface share one socket runtime and storage
		layer. Each route is a link you can share.
	</p>

	<GrepFilter label="Filter HTTP routes" />

	{groups.map((group) => (
		<section id={group.id} data-grep-section>
			<h2 class="rule-label">{group.label}</h2>
			<div class="ref-block ref-block--route">
				<p class="ref__head ref__row" aria-hidden="true">
					<span>method</span><span>path</span><span>purpose</span>
				</p>
				<ul class="log log--static ref" aria-label={`${group.label} endpoints`}>
					{group.routes.map((r) => (
						<li id={routeId(r)} class="ref__row">
							<span class="ref__method">{r.method}</span>
							<a class="self" href={`#${routeId(r)}`}><code>{r.path}</code></a>
							<span class="ref__desc">{r.desc}</span>
						</li>
					))}
				</ul>
			</div>
		</section>
	))}
</DocsNode>
