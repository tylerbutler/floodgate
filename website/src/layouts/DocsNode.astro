---
import Terminal from "./Terminal.astro";
import { nodeNav } from "../data/docs-nodes";

interface Props {
	slug: string;
	description: string;
}

const { slug, description } = Astro.props;
const { node, prev, next } = nodeNav(slug);
const up = { href: "/docs", label: "docs" };
---

<Terminal title={`${node.title} — Floodgate docs`} description={description} path={`/docs/${slug}`}>
	<article class="node">
		<div class="node__head">
			<span>File: <strong>floodgate.info</strong>,</span>
			<span>Node: <strong>{node.title}</strong>,</span>
			<span>Next: <a href={next ? next.href : "/docs"}>{next ? next.title : "(dir)"}</a>,</span>
			<span>Prev: <a href={prev ? prev.href : "/docs"}>{prev ? prev.title : "(dir)"}</a>,</span>
			<span>Up: <a href={up.href}>{up.label}</a></span>
		</div>
		<h1>{node.title}</h1>
		<div class="node__body">
			<slot />
		</div>
		<div class="node__foot">
			{prev && <a href={prev.href}>&larr; Prev: {prev.title}</a>}
			<a href={up.href}>&uarr; Up: docs</a>
			{next && <a href={next.href}>Next: {next.title} &rarr;</a>}
		</div>
	</article>
</Terminal>
