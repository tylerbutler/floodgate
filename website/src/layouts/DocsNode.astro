---
import Terminal from "./Terminal.astro";
import { nodeNav } from "../data/docs-nodes";
import ArrowIcon from "../components/ArrowIcon.astro";
import DocsNav from "../components/DocsNav.astro";

interface Props {
	slug: string;
	description: string;
}

const { slug, description } = Astro.props;
const { node, prev, next } = nodeNav(slug);
---

<Terminal title={`${node.title} — Floodgate docs`} description={description} path={`/docs/${slug}`}>
	<article class="node">
		<div class="node__head">
			<span>Documentation</span>
			<span aria-hidden="true">/</span>
			<strong>{node.title}</strong>
		</div>
		<DocsNav currentPath={`/docs/${slug}`} />
		<h1>{node.title}</h1>
		<div class="node__body">
			<slot />
		</div>
		<div class="node__foot">
			{prev && <a class="node__foot-prev" href={prev.href}><ArrowIcon direction="left" /> {prev.title}</a>}
			{next && <a class="node__foot-next" href={next.href}>{next.title} <ArrowIcon direction="right" /></a>}
		</div>
	</article>
</Terminal>
