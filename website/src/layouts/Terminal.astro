---
import "../styles/global.css";

interface Props {
	title: string;
	description: string;
	path: string;
}

const { title, description, path } = Astro.props;

const ogImage = new URL("/og.png", Astro.site ?? Astro.url);
const canonical = new URL(path, Astro.site ?? Astro.url);
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{title}</title>
		<meta name="description" content={description} />
		<meta property="og:type" content="website" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonical} />
		<meta property="og:image" content={ogImage} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content="Floodgate operations status wall showing isolated document sessions, two wire protocols, and a Docker launch command." />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={ogImage} />
		<link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 16 16'%3E%3Crect width='16' height='16' rx='3' fill='%2310233f'/%3E%3Cpath d='M3 4h10v2H5v2h6v2H5v3H3z' fill='%23f0b429'/%3E%3C/svg%3E" />
	</head>
	<body>
		<!--
		THESIS: Floodgate is a live operations wall where one document can fail and recover without disturbing its neighbors; it refuses the generic developer hero and feature-card grid.
		OWN-WORLD: Deep navy panels, warm white reading fields, yellow action cards, and red, green, and blue state strips form a powder-coated incident-command system.
		STORY: Visitors see fault isolation happen, understand the dual-protocol server, and launch it with Docker from the first viewport.
		FIRST VIEWPORT: A large promise spans the wall above a live document recovery lane and a fixed Docker run card; navigation stays compact at the top edge.
		FORM: Operations Status Wall, sixth grounded direction, seed 52f56dfd.
		FINISH: unreviewed and undocumented is unfinished; this build ends with the finish review, the verdict, DESIGN.md, and every shipping raster carrying its provenance
		-->
		<a class="skip-link" href="#main-content">skip to content</a>
		<div class="term-bar">
			<div class="term-bar__inner">
				<a class="term-bar__brand" href="/" aria-label="Floodgate home">
					<span class="term-bar__mark" aria-hidden="true">F</span>
					<span>Floodgate</span>
				</a>
				<span class="term-bar__path"><span class="term-bar__host">Surface</span><span data-term-path>{path}</span></span>
				<nav aria-label="Site">
					<a href="/" aria-current={path === "/" ? "page" : undefined}>Overview</a>
					<a href="/architecture" aria-current={path === "/architecture" ? "page" : undefined}>Architecture</a>
					<a href="/docs/getting-started" aria-current={path.startsWith("/docs") ? "page" : undefined}>Docs</a>
				</nav>
			</div>
		</div>
		<main id="main-content">
			<slot />
		</main>
		<footer class="term-foot">
			<span class="term-foot__status"><span aria-hidden="true"></span> Floodgate project</span>
			<a href="https://github.com/tylerbutler/floodgate" rel="noopener external">Source on GitHub</a>
			<a href="https://github.com/tylerbutler/floodgate/blob/main/LICENSE" rel="noopener external">MIT License</a>
			<span>By Tyler Butler</span>
		</footer>
	</body>
</html>
